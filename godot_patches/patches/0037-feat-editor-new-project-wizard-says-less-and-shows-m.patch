+// Three dots, one per step: the current one in the text colour and wider,
+// the others faint. No accent, so the step's Next stays the one accent.
+void ProjectDialog::_joinery_draw_stepper() {
+	const int total = _joinery_total_steps();
+	const float dot = 6 * EDSCALE;
+	const float wide = 16 * EDSCALE;
+	const float gap = 6 * EDSCALE;
+	const Size2 size(wide + (total - 1) * (dot + gap), dot);
+	if (joinery_stepper->get_custom_minimum_size() != size) {
+		joinery_stepper->set_custom_minimum_size(size);
+	}
+	const Color ink = get_theme_color(SceneStringName(font_color), SNAME("Label"));
+	const Color faint = get_theme_color(SceneStringName(font_color), SNAME("JoineryCaption"));
+	Ref<StyleBoxFlat> pill;
+	pill.instantiate();
+	pill->set_corner_radius_all(dot / 2);
+	float x = 0;
+	for (int i = 0; i < total; i++) {
+		const bool current = i == joinery_page;
+		const float w = current ? wide : dot;
+		pill->set_bg_color(current ? ink : Color(faint, 0.45));
+		joinery_stepper->draw_style_box(pill, Rect2(x, 0, w, dot));
+		x += w + gap;
+	}
+}
