+// The segmented control's look, from the theme's own field and secondary
+// button: the track is the field, a part at rest is bare text on it, and the
+// chosen part is the raised secondary fill, inset one step.
+void ProjectDialog::_joinery_style_segments() {
+	if (!joinery_connect_track || !joinery_connect_steam || !is_inside_tree()) {
+		return;
+	}
+	const Ref<StyleBoxFlat> field = get_theme_stylebox(CoreStringName(normal), SNAME("JoineryField"));
+	if (field.is_valid()) {
+		Ref<StyleBoxFlat> track = field->duplicate();
+		track->set_content_margin_all(_joinery_space(1));
+		joinery_connect_track->add_theme_style_override(SceneStringName(panel), track);
+	}
+	const Ref<StyleBoxFlat> raised = get_theme_stylebox(CoreStringName(normal), SNAME("JoinerySecondaryButton"));
+	if (raised.is_null()) {
+		return;
+	}
+	Ref<StyleBoxFlat> rest = raised->duplicate();
+	rest->set_draw_center(false);
+	rest->set_border_width_all(0);
+	Ref<StyleBoxFlat> chosen = raised->duplicate();
+	chosen->set_corner_radius_all(MAX(4 * EDSCALE, raised->get_corner_radius(CORNER_TOP_LEFT) - _joinery_space(1)));
+	for (Button *part : { joinery_connect_steam, joinery_connect_direct }) {
+		part->add_theme_style_override(CoreStringName(normal), rest);
+		part->add_theme_style_override(SceneStringName(pressed), chosen);
+		part->add_theme_style_override(SNAME("hover_pressed"), chosen);
+		part->add_theme_color_override(SceneStringName(font_color), get_theme_color(SceneStringName(font_color), SNAME("JoineryCaption")));
+	}
+}
