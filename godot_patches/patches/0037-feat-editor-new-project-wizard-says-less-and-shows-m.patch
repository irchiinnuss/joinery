+// Five colours from the pictures: k-means over a sample of their pixels,
+// ordered dark to light. The swatches are then the user's to change.
+void ProjectDialog::_joinery_pick_palette() {
+	Vector<Color> pixels;
+	for (const Ref<Image> &image : joinery_ref_images) {
+		if (image.is_null()) {
+			continue;
+		}
+		Ref<Image> small = image->duplicate();
+		small->resize(32, 24, Image::INTERPOLATE_BILINEAR);
+		small->convert(Image::FORMAT_RGB8);
+		for (int y = 0; y < small->get_height(); y++) {
+			for (int x = 0; x < small->get_width(); x++) {
+				pixels.push_back(small->get_pixel(x, y));
+			}
+		}
+	}
+	if (pixels.is_empty()) {
+		return;
+	}
+	Color centres[JOINERY_SWATCHES];
+	for (int k = 0; k < JOINERY_SWATCHES; k++) {
+		centres[k] = pixels[(int)((int64_t)k * (pixels.size() - 1) / MAX(1, JOINERY_SWATCHES - 1))];
+	}
+	for (int round = 0; round < 10; round++) {
+		Color sums[JOINERY_SWATCHES];
+		int counts[JOINERY_SWATCHES] = {};
+		for (const Color &c : pixels) {
+			int best = 0;
+			float best_d = 1e9;
+			for (int k = 0; k < JOINERY_SWATCHES; k++) {
+				const float d = Vector3(c.r - centres[k].r, c.g - centres[k].g, c.b - centres[k].b).length_squared();
+				if (d < best_d) {
+					best_d = d;
+					best = k;
+				}
+			}
+			sums[best] = Color(sums[best].r + c.r, sums[best].g + c.g, sums[best].b + c.b);
+			counts[best]++;
+		}
+		for (int k = 0; k < JOINERY_SWATCHES; k++) {
+			if (counts[k] > 0) {
+				centres[k] = Color(sums[k].r / counts[k], sums[k].g / counts[k], sums[k].b / counts[k]);
+			}
+		}
+	}
+	Vector<Color> ordered;
+	for (const Color &c : centres) {
+		ordered.push_back(c);
+	}
+	ordered.sort_custom<_JoineryLuminanceLess>();
+	for (int k = 0; k < JOINERY_SWATCHES; k++) {
+		joinery_palette[k] = ordered[k];
+		joinery_palette_set[k] = true;
+	}
+	_joinery_palette_changed();
+}
+
+// The chosen colours, as the palette answer: "#2b3a4f, #c98a4b".
+void ProjectDialog::_joinery_palette_changed() {
+	Vector<String> hexes;
+	for (int i = 0; i < JOINERY_SWATCHES; i++) {
+		if (joinery_palette_set[i]) {
+			hexes.push_back("#" + joinery_palette[i].to_html(false));
+		}
+		if (joinery_swatches[i]) {
+			joinery_swatches[i]->set_tooltip_text(joinery_palette_set[i] ? "#" + joinery_palette[i].to_html(false) : TTR("Choose a colour"));
+			joinery_swatches[i]->queue_redraw();
+		}
+	}
+	if (joinery_palette_field) {
+		joinery_palette_field->set_text(String(", ").join(hexes));
+	}
 }
 
