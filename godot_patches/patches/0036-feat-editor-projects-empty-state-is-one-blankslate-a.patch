+// The chip is a button with a row drawn on it: its size is the row's, plus
+// the button's own padding on each side.
+void ProjectManager::_joinery_fit_agent_chip() {
+	if (!joinery_agent_menu || !joinery_agent_row || !is_inside_tree()) {
+		return;
+	}
+	const int pad = 12 * EDSCALE;
+	joinery_agent_row->set_offset(SIDE_LEFT, pad);
+	joinery_agent_row->set_offset(SIDE_RIGHT, -pad);
+	const Size2 row = joinery_agent_row->get_combined_minimum_size();
+	const int height = (int)Math::round(get_theme_font_size(SNAME("main_size"), EditorStringName(EditorFonts)) * 2.5);
+	joinery_agent_menu->set_custom_minimum_size(Size2(row.x + 2 * pad, MAX((float)height, row.y)));
+}
+
+void ProjectManager::_joinery_agent_menu(int p_id) {
