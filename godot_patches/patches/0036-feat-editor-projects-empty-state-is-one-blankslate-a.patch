+// Three starting points as pictures over the empty state's heading: the same
+// captures the new-project wizard shows on its cards (blueprints/<id>/
+// capture.png beside the engine). Only a preview, so they take no input; any
+// that is missing is left out, and with none the heading stands alone.
+void ProjectManager::_joinery_build_blankslate() {
+	if (!joinery_blank_shots || joinery_blank_shots->get_child_count() > 0 || joinery_home.is_empty()) {
+		return;
+	}
+	const int width = 152 * EDSCALE;
+	for (const char *id : { "first-person-3d", "platformer-2d", "top-down" }) {
+		const String path = joinery_home.path_join("blueprints").path_join(id).path_join("capture.png");
+		if (!FileAccess::exists(path)) {
+			continue;
+		}
+		const Ref<Image> image = Image::load_from_file(path);
+		if (image.is_null() || image->is_empty()) {
+			continue;
+		}
+		Ref<Image> shot = image->duplicate();
+		const int height = width * 9 / 16;
+		shot->resize(width, height, Image::INTERPOLATE_LANCZOS);
+		TextureRect *picture = memnew(TextureRect);
+		picture->set_texture(ImageTexture::create_from_image(shot));
+		picture->set_expand_mode(TextureRect::EXPAND_IGNORE_SIZE);
+		picture->set_stretch_mode(TextureRect::STRETCH_KEEP_ASPECT_COVERED);
+		picture->set_custom_minimum_size(Size2(width, height));
+		picture->set_mouse_filter(MOUSE_FILTER_IGNORE);
+		// Rounded like the wizard's cards: the frame's shape clips the picture.
+		PanelContainer *frame = memnew(PanelContainer);
+		Ref<StyleBoxFlat> shape;
+		shape.instantiate();
+		shape->set_corner_radius_all(8 * EDSCALE);
+		shape->set_content_margin_all(0);
+		frame->add_theme_style_override(SceneStringName(panel), shape);
+		frame->set_clip_children_mode(CLIP_CHILDREN_ONLY);
+		frame->set_mouse_filter(MOUSE_FILTER_IGNORE);
+		frame->add_child(picture);
+		joinery_blank_shots->add_child(frame);
+	}
+	joinery_blank_shots->set_visible(joinery_blank_shots->get_child_count() > 0);
+}
